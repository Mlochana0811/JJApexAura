# Copy to .env. setup.py generates a unique local SECRET_KEY.
DEBUG=true
SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
PUBLIC_URL=http://localhost:5173/app
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hr@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Required by Docker Compose; change before first use.
POSTGRES_PASSWORD=change-this-before-running-docker
